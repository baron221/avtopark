generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  OWNER
  ACCOUNTANT
  DISPATCHER
  MECHANIC
  DRIVER
}

enum Point {
  FARGONA
  QUVA
}

enum VehicleType {
  AVTOBUS
  FURGON
}

enum VehicleStatus {
  ACTIVE
  NOT_ON_LINE
  ON_ORDER
  REPAIR
  RENTED
}

enum SalaryType {
  FIXED
  PERCENT
  PLAN_SURPLUS
}

enum PlanStatus {
  FULL
  PARTIAL
  PENDING
  REPAIR
}

enum RentalStatus {
  ACTIVE
  ENDED
}

enum ExpenseCategory {
  FUEL
  SALARY
  REPAIR
  INSURANCE
  TAX
  TOLL
  OTHER
}

enum FuelType {
  METAN
  BENZIN
  DIZEL
}

enum PayPeriod {
  WEEK
  HALF_MONTH
  MONTH
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
}

enum SalaryStatus {
  DRAFT
  APPROVED
  PAID
}

enum StaffExpensePoint {
  FARGONA
  QUVA
  YOLDA
  ISHXONA
}

enum TripKind {
  TRIP
  ORDER
}

enum StaffExpenseCategory {
  STOYANKA
  OZIQ_OVQAT
  OBED
  BOSHQA
}

// Cash a dispatcher collects from a vehicle that isn't part of the
// company's own fleet — a tax/paperwork fee, fuel sold, a parking-lot
// charge, etc. See OtherIncome.
enum OtherIncomeCategory {
  SOLIQ
  YOQILGI
  STOYANKA
  BOSHQA
}

// ---------- Models ----------

model User {
  id                  String    @id @default(uuid())
  fullName            String    @map("full_name")
  phone               String    @unique
  role                Role
  point               Point?
  baseSalary          BigInt?   @map("base_salary")
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")

  driver                     Driver?
  enteredTrips               Trip[]               @relation("TripEnteredBy")
  enteredOtherIncomes        OtherIncome[]        @relation("OtherIncomeEnteredBy")
  externalVehiclesCreated    ExternalVehicle[]    @relation("ExternalVehicleCreatedBy")
  enteredExpenses            Expense[]            @relation("ExpenseEnteredBy")
  finesReceived              Fine[]               @relation("FineUser")
  finesEntered               Fine[]               @relation("FineEnteredBy")
  lunches                    Lunch[]              @relation("LunchUser")
  lunchesEntered             Lunch[]              @relation("LunchEnteredBy")
  fuelLogsEntered            FuelLog[]            @relation("FuelLogEnteredBy")
  stationPaymentsEntered     StationPayment[]     @relation("StationPaymentEnteredBy")
  staffExpenses              StaffExpense[]       @relation("StaffExpenseUser")
  staffExpensesEntered       StaffExpense[]       @relation("StaffExpenseEnteredBy")
  salaries                   Salary[]             @relation("SalaryUser")
  salariesApproved           Salary[]             @relation("SalaryApprovedBy")
  salariesPaid               Salary[]             @relation("SalaryPaidBy")
  planPaymentsReceived       PlanPayment[]        @relation("PlanPaymentReceivedBy")
  advances                   Advance[]            @relation("AdvanceUser")
  advancesEntered            Advance[]            @relation("AdvanceEnteredBy")
  oilChangesEntered          OilChange[]          @relation("OilChangeEnteredBy")
  deletionsPerformed         DeletionLog[]        @relation("DeletionLogDeletedBy")
  editsPerformed             EditLog[]            @relation("EditLogEditedBy")
  cashHandoversAsDispatcher  CashHandover[]       @relation("CashHandoverDispatcher")
  cashHandoversAsAccountant  CashHandover[]       @relation("CashHandoverAccountant")
  ownerPayoutsEntered        OwnerPayout[]        @relation("OwnerPayoutEnteredBy")
  cashOpeningBalancesEntered CashOpeningBalance[] @relation("CashOpeningBalanceEnteredBy")

  @@index([role])
  @@index([point])
  @@map("users")
}

// Deleting a Trip/StaffExpense/Lunch/User removes the row entirely (this app
// intentionally has no soft-delete), so without this there was no way to
// answer "who deleted this and when" after the fact. entityType/entityId are
// plain strings, not a real FK, since the row they point at is gone by the
// time this exists.
model DeletionLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  deletedBy  String   @map("deleted_by")
  deletedAt  DateTime @default(now()) @map("deleted_at")

  deletedByUser User @relation("DeletionLogDeletedBy", fields: [deletedBy], references: [id])

  @@index([deletedAt])
  @@index([entityType, entityId])
  @@map("deletion_logs")
}

// Parallel to DeletionLog, but for edits to an existing record's amount —
// this app has no general edit history, so before this a Trip/StaffExpense/
// Lunch amount silently changed after that day's cash was already handed
// over/confirmed left no trace (see ownerPayout.ts's comment on why the
// handover snapshot can drift from the live recomputed total).
model EditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  editedBy   String   @map("edited_by")
  editedAt   DateTime @default(now()) @map("edited_at")

  editedByUser User @relation("EditLogEditedBy", fields: [editedBy], references: [id])

  @@index([editedAt])
  @@index([entityType, entityId])
  @@map("edit_logs")
}

model Vehicle {
  id            String        @id @default(uuid())
  plate         String        @unique
  model         String
  type          VehicleType
  seats         Int
  status        VehicleStatus @default(ACTIVE)
  point         Point?
  purchasePrice BigInt        @map("purchase_price")
  purchaseDate  DateTime      @map("purchase_date")
  odometerKm    Int?          @map("odometer_km")

  driver           Driver?
  trips            Trip[]
  dailyPlans       DailyPlan[]
  rentals          Rental[]
  expenses         Expense[]
  shifts           Shift[]
  fines            Fine[]
  fuelLogs         FuelLog[]
  oilChanges       OilChange[]
  assignmentLogs   DriverAssignmentLog[]
  mileages         VehicleMileage[]
  gpsDetectedTrips GpsDetectedTrip[]
  movementWatch    VehicleMovementWatch?
  signalAlert      VehicleSignalAlert?

  @@index([point])
  @@index([status])
  @@map("vehicles")
}

// A serviced oil change also creates a matching Expense (category REPAIR) so
// its cost is already counted in profit/expense reports — this model exists
// only to track the maintenance-specific due-date/due-mileage data that
// Expense has no room for.
model OilChange {
  id             String   @id @default(uuid())
  vehicleId      String   @map("vehicle_id")
  changedAt      DateTime @map("changed_at")
  odometerKm     Int      @map("odometer_km")
  intervalKm     Int      @map("interval_km")
  intervalMonths Int      @map("interval_months")
  amount         BigInt
  note           String?
  enteredBy      String   @map("entered_by")

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  enteredByUser User    @relation("OilChangeEnteredBy", fields: [enteredBy], references: [id])

  @@index([vehicleId, changedAt])
  @@map("oil_changes")
}

// One row per vehicle per calendar day, written once daily by a Vercel Cron
// job (see /api/gps/daily-mileage) replaying that day's GPS track — kept as
// a durable snapshot because Wialon's own message history isn't something
// we can cheaply re-query for a month-long trend on every page view.
model VehicleMileage {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  date      DateTime
  km        Float

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([vehicleId, date])
  @@map("vehicle_mileages")
}

enum GpsTripDirection {
  FARGONA_TO_QUVA
  QUVA_TO_FARGONA
}

// One row per station-to-station transit independently detected from a
// vehicle's raw Wialon GPS track (see lib/gpsTripDetection.ts) — not tied
// to any dispatcher-entered Trip. Exists purely to let the accountant/owner
// compare "GPS says this many transits happened" against "dispatcher logged
// this many trips" for the same vehicle/day, to catch under- or
// over-reporting. detectedAt is when the track shows the vehicle arriving
// at the destination station, not when the trip actually started.
model GpsDetectedTrip {
  id         String           @id @default(uuid())
  vehicleId  String           @map("vehicle_id")
  direction  GpsTripDirection
  detectedAt DateTime         @map("detected_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, detectedAt])
  @@map("gps_detected_trips")
}

// One row per vehicle currently NOT_ON_LINE (shouldn't be moving at all) —
// see /api/gps/movement-watch. REPAIR is deliberately excluded: a mechanic
// routinely test-drives/repositions a vehicle under repair, which would
// otherwise fire constant false alerts. lastLat/lastLon is the position
// from the *previous* check, not a fixed parking spot, so the comparison is
// always "did it move since we last looked" rather than requiring a
// separately-defined rest location. alertedAt is set the moment a Telegram
// alert fires and left set (not cleared on every check) so a vehicle that
// keeps driving doesn't re-alert every ~10 minutes — it only clears when
// the row is deleted, which happens once the vehicle leaves NOT_ON_LINE.
model VehicleMovementWatch {
  vehicleId String    @id @map("vehicle_id")
  lastLat   Float     @map("last_lat")
  lastLon   Float     @map("last_lon")
  alertedAt DateTime? @map("alerted_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_movement_watches")
}

// One row per vehicle whose Wialon tracker has gone quiet for longer than
// the threshold (see /api/gps/signal-watch) — a dead battery, no GSM
// coverage, or someone physically disconnecting the device (often the
// first thing done before an unauthorized trip). Deleted the moment the
// tracker reports again, so a future outage re-alerts from scratch.
model VehicleSignalAlert {
  vehicleId String   @id @map("vehicle_id")
  alertedAt DateTime @map("alerted_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_signal_alerts")
}

model Driver {
  id          String     @id @default(uuid())
  userId      String     @unique @map("user_id")
  vehicleId   String?    @unique @map("vehicle_id")
  licenseNo   String     @map("license_no")
  salaryType  SalaryType @map("salary_type")
  salaryValue Decimal    @map("salary_value")
  hiredAt     DateTime   @map("hired_at")

  user    User     @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  trips          Trip[]
  dailyPlans     DailyPlan[]
  expenses       Expense[]
  shifts         Shift[]
  fuelLogs       FuelLog[]
  assignmentLogs DriverAssignmentLog[]

  @@map("drivers")
}

model Route {
  id         String  @id @default(uuid())
  fromCity   String  @map("from_city")
  toCity     String  @map("to_city")
  distanceKm Int     @map("distance_km")
  baseFare   Int     @map("base_fare")
  isActive   Boolean @default(true) @map("is_active")

  trips Trip[]

  @@map("routes")
}

model Trip {
  id             String   @id @default(uuid())
  vehicleId      String   @map("vehicle_id")
  driverId       String   @map("driver_id")
  routeId        String   @map("route_id")
  // Which point's dispatcher collected/entered this trip's revenue. Kept
  // separate from Vehicle.point because the same shared fleet shuttles both
  // Farg'ona and Quva — a vehicle has no single "home" point, so the point
  // that matters for cash-collection reporting has to live on the Trip itself.
  point          Point
  tripDate       DateTime @map("trip_date")
  departureTime  DateTime @map("departure_time")
  passengerCount Int      @map("passenger_count")
  tripNumber     Int?     @map("trip_number")
  revenue        BigInt
  kind           TripKind @default(TRIP)
  note           String?
  enteredBy      String   @map("entered_by")
  createdAt      DateTime @default(now()) @map("created_at")

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  driver        Driver  @relation(fields: [driverId], references: [id])
  route         Route   @relation(fields: [routeId], references: [id])
  enteredByUser User    @relation("TripEnteredBy", fields: [enteredBy], references: [id])

  @@index([vehicleId, tripDate])
  @@index([driverId])
  @@index([tripDate])
  @@index([point, tripDate])
  @@map("trips")
}

// Income from a vehicle that isn't part of the company's own fleet — it has
// no vehicleId/driverId to attach to (unlike Trip), since those vehicles
// don't exist in this system at all. plateNumber is the primary identifier;
// note is just a free-text comment on top of it, so both are optional.
model OtherIncome {
  id          String              @id @default(uuid())
  point       Point
  category    OtherIncomeCategory @default(BOSHQA)
  amount      BigInt
  note        String?
  plateNumber String?             @map("plate_number")
  incomeDate  DateTime            @map("income_date")
  enteredBy   String              @map("entered_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  enteredByUser User @relation("OtherIncomeEnteredBy", fields: [enteredBy], references: [id])

  @@index([point, incomeDate])
  @@map("other_incomes")
}

// A known non-fleet vehicle that regularly pays the company (see
// OtherIncome) — lets the plate number field autocomplete instead of being
// typed fresh every time. Not a foreign key from OtherIncome (that stays a
// free-text plateNumber) since a one-off payer that's never added here must
// still be enterable.
model ExternalVehicle {
  id        String   @id @default(uuid())
  plate     String   @unique
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  createdByUser User @relation("ExternalVehicleCreatedBy", fields: [createdBy], references: [id])

  @@map("external_vehicles")
}

model DailyPlan {
  id         String     @id @default(uuid())
  vehicleId  String     @map("vehicle_id")
  driverId   String     @map("driver_id")
  planDate   DateTime   @map("plan_date")
  planAmount BigInt     @map("plan_amount")
  paidAmount BigInt     @default(0) @map("paid_amount")
  status     PlanStatus @default(PENDING)
  paidAt     DateTime?  @map("paid_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  planPayments PlanPayment[]

  @@unique([vehicleId, planDate])
  @@index([driverId])
  @@index([planDate])
  @@map("daily_plans")
}

model Rental {
  id            String       @id @default(uuid())
  vehicleId     String       @map("vehicle_id")
  renterName    String       @map("renter_name")
  renterPhone   String       @map("renter_phone")
  monthlyAmount BigInt       @map("monthly_amount")
  startDate     DateTime     @map("start_date")
  endDate       DateTime?    @map("end_date")
  status        RentalStatus @default(ACTIVE)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("rentals")
}

model Expense {
  id          String          @id @default(uuid())
  vehicleId   String          @map("vehicle_id")
  driverId    String?         @map("driver_id")
  category    ExpenseCategory
  amount      BigInt
  expenseDate DateTime        @map("expense_date")
  note        String?
  enteredBy   String          @map("entered_by")

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  driver        Driver?  @relation(fields: [driverId], references: [id])
  enteredByUser User     @relation("ExpenseEnteredBy", fields: [enteredBy], references: [id])
  fuelLog       FuelLog?

  @@index([vehicleId, expenseDate])
  @@index([expenseDate])
  @@map("expenses")
}

// One driver per vehicle per month — no morning/evening split, assigned
// once for the whole month rather than re-picked every day.
model Shift {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  driverId  String   @map("driver_id")
  month     DateTime // first day of the covered month
  note      String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  fuelLogs FuelLog[]

  @@unique([vehicleId, month])
  @@index([driverId])
  @@map("shifts")
}

// A dated log of exactly who drove which vehicle when — separate from Shift
// (which only ever tracks the current month's single assignment) so that
// mid-month driver swaps (e.g. one driver gets tired and hands off to
// another) leave a real audit trail instead of silently overwriting who
// drove earlier in the month. endedAt is null while the assignment is still
// current.
model DriverAssignmentLog {
  id        String    @id @default(uuid())
  vehicleId String    @map("vehicle_id")
  driverId  String    @map("driver_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId, startedAt])
  @@index([driverId])
  @@map("driver_assignment_logs")
}

model Fine {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  vehicleId String?  @map("vehicle_id")
  amount    BigInt
  reason    String
  fineDate  DateTime @map("fine_date")
  deducted  Boolean  @default(false)
  enteredBy String   @map("entered_by")

  user          User     @relation("FineUser", fields: [userId], references: [id])
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  enteredByUser User     @relation("FineEnteredBy", fields: [enteredBy], references: [id])

  @@index([userId, fineDate])
  @@map("fines")
}

model Lunch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // Which point's dispatcher recorded this lunch — kept separate from the
  // recipient's own point (drivers have none, since the fleet is shared)
  // for the same reason Trip.point exists.
  point     Point
  amount    BigInt
  lunchDate DateTime @map("lunch_date")
  enteredBy String   @map("entered_by")

  user          User @relation("LunchUser", fields: [userId], references: [id])
  enteredByUser User @relation("LunchEnteredBy", fields: [enteredBy], references: [id])

  @@unique([userId, lunchDate])
  @@index([point, lunchDate])
  @@map("lunches")
}

model FuelStation {
  id         String    @id @default(uuid())
  name       String
  fuelType   FuelType  @map("fuel_type")
  contractNo String    @map("contract_no")
  unitPrice  BigInt    @map("unit_price")
  payPeriod  PayPeriod @map("pay_period")
  isActive   Boolean   @default(true) @map("is_active")

  fuelLogs        FuelLog[]
  stationPayments StationPayment[]

  @@map("fuel_stations")
}

model FuelLog {
  id        String   @id @default(uuid())
  stationId String   @map("station_id")
  vehicleId String   @map("vehicle_id")
  driverId  String   @map("driver_id")
  shiftId   String?  @map("shift_id")
  // The matching Expense (category FUEL) created alongside this row, so
  // editing/deleting a fuel log can keep the expense — and profit/expense
  // reports, which only read Expense — in sync. Nullable because rows
  // created before this field existed have no linked expense.
  expenseId String?  @unique @map("expense_id")
  volume    Decimal
  amount    BigInt
  filledAt  DateTime @map("filled_at")
  enteredBy String   @map("entered_by")

  station       FuelStation @relation(fields: [stationId], references: [id])
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  driver        Driver      @relation(fields: [driverId], references: [id])
  shift         Shift?      @relation(fields: [shiftId], references: [id])
  expense       Expense?    @relation(fields: [expenseId], references: [id])
  enteredByUser User        @relation("FuelLogEnteredBy", fields: [enteredBy], references: [id])

  @@index([vehicleId])
  @@index([stationId])
  @@index([filledAt])
  @@map("fuel_logs")
}

model StationPayment {
  id          String        @id @default(uuid())
  stationId   String        @map("station_id")
  periodStart DateTime      @map("period_start")
  periodEnd   DateTime      @map("period_end")
  totalVolume Decimal       @map("total_volume")
  amount      BigInt
  paidAmount  BigInt        @default(0) @map("paid_amount")
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?     @map("paid_at")
  enteredBy   String        @map("entered_by")

  station       FuelStation @relation(fields: [stationId], references: [id])
  enteredByUser User        @relation("StationPaymentEnteredBy", fields: [enteredBy], references: [id])

  @@index([stationId])
  @@index([periodEnd])
  @@map("station_payments")
}

model StaffExpense {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  point       StaffExpensePoint
  category    StaffExpenseCategory @default(BOSHQA)
  amount      BigInt
  note        String?
  expenseDate DateTime             @map("expense_date")
  enteredBy   String               @map("entered_by")

  user          User @relation("StaffExpenseUser", fields: [userId], references: [id])
  enteredByUser User @relation("StaffExpenseEnteredBy", fields: [enteredBy], references: [id])

  @@index([userId, expenseDate])
  @@index([point, expenseDate])
  @@map("staff_expenses")
}

model Salary {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  month         DateTime
  baseSalary    BigInt       @map("base_salary")
  bonus         BigInt       @default(0)
  advancesTotal BigInt       @default(0) @map("advances_total")
  finesTotal    BigInt       @default(0) @map("fines_total")
  lunchTotal    BigInt       @default(0) @map("lunch_total")
  netPay        BigInt       @map("net_pay")
  status        SalaryStatus @default(DRAFT)
  approvedBy    String?      @map("approved_by")
  paidAt        DateTime?    @map("paid_at")
  paidBy        String?      @map("paid_by")

  user           User  @relation("SalaryUser", fields: [userId], references: [id])
  approvedByUser User? @relation("SalaryApprovedBy", fields: [approvedBy], references: [id])
  paidByUser     User? @relation("SalaryPaidBy", fields: [paidBy], references: [id])

  @@unique([userId, month])
  @@map("salaries")
}

model PlanPayment {
  id          String        @id @default(uuid())
  dailyPlanId String        @map("daily_plan_id")
  amount      BigInt
  method      PaymentMethod
  paidAt      DateTime      @map("paid_at")
  receivedBy  String        @map("received_by")

  dailyPlan      DailyPlan @relation(fields: [dailyPlanId], references: [id])
  receivedByUser User      @relation("PlanPaymentReceivedBy", fields: [receivedBy], references: [id])

  @@map("plan_payments")
}

// Not in the original 17 tables — added per README instruction: the payroll
// screen already shows an Avans column, so this table backs it.
model Advance {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    BigInt
  givenDate DateTime @map("given_date")
  month     DateTime
  enteredBy String   @map("entered_by")

  user          User @relation("AdvanceUser", fields: [userId], references: [id])
  enteredByUser User @relation("AdvanceEnteredBy", fields: [enteredBy], references: [id])

  @@index([userId, month])
  @@index([month])
  @@map("advances")
}

// A dispatcher hands over one day's cash-in-hand to the accountant once a
// day, in person — this just tracks the two-sided confirmation of that
// handoff (dispatcher says "I gave it", accountant says "I received it"),
// it doesn't move any money itself. amount is a snapshot of that point's
// total income at the moment the dispatcher confirms, not a live figure —
// it represents cash actually counted and handed over, so it must not
// silently drift if a trip is entered afterward.
model CashHandover {
  id                    String    @id @default(uuid())
  point                 Point
  handoverDate          DateTime  @map("handover_date")
  amount                BigInt
  // Only set when the dispatcher overrode the auto-computed
  // kirim-chiqim amount — required in that case so there's always an
  // audit trail for why the handed-over cash didn't match the log.
  note                  String?
  dispatcherConfirmedBy String    @map("dispatcher_confirmed_by")
  dispatcherConfirmedAt DateTime  @map("dispatcher_confirmed_at")
  accountantConfirmedBy String?   @map("accountant_confirmed_by")
  accountantConfirmedAt DateTime? @map("accountant_confirmed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  dispatcherConfirmedByUser User  @relation("CashHandoverDispatcher", fields: [dispatcherConfirmedBy], references: [id])
  accountantConfirmedByUser User? @relation("CashHandoverAccountant", fields: [accountantConfirmedBy], references: [id])

  @@unique([point, handoverDate])
  @@index([handoverDate])
  @@map("cash_handovers")
}

// The accountant's confirmed CashHandover cash isn't handed to the real
// business owner immediately — it's a shared cash pool (not split by
// point, since most expenses paid out of it aren't point-attributable
// either) that accumulates until the accountant physically pays it out.
// This is that payout record: a single accountant-entered fact (no
// two-sided confirm, unlike CashHandover), since there's no second party
// confirming a payout to the owner. The balance it reduces is a derived
// figure (see getCashLedgerSummary), not stored anywhere directly.
model OwnerPayout {
  id         String   @id @default(uuid())
  amount     BigInt
  payoutDate DateTime @map("payout_date")
  note       String?
  enteredBy  String   @map("entered_by")
  createdAt  DateTime @default(now()) @map("created_at")

  enteredByUser User @relation("OwnerPayoutEnteredBy", fields: [enteredBy], references: [id])

  @@index([payoutDate])
  @@map("owner_payouts")
}

// A reconciliation point: the accountant physically counts the cash on
// hand and records it here. The cash-balance formula (see
// getCashLedgerSummary) only counts CashHandover/expense/payout activity
// from the most recent entry's setDate onward — without this, summing
// EVERY historical Expense/Salary/Advance row against a CashHandover
// tracker that only started accruing recently produced a deeply negative,
// meaningless number (months of expense history vs. days of income
// history). Multiple rows may exist over time as an audit trail; only the
// latest one is live.
model CashOpeningBalance {
  id        String   @id @default(uuid())
  amount    BigInt
  setDate   DateTime @map("set_date")
  note      String?
  enteredBy String   @map("entered_by")
  createdAt DateTime @default(now()) @map("created_at")

  enteredByUser User @relation("CashOpeningBalanceEnteredBy", fields: [enteredBy], references: [id])

  @@index([setDate])
  @@map("cash_opening_balances")
}

// Admin-grantable extra VIEW-only access for a role to a module that role
// doesn't have by default (e.g. Dispatcher viewing the vehicles list).
// Presence of a row = granted. Never widens write/OWN-scoped access.
model RolePermission {
  id        String   @id @default(uuid())
  role      Role
  module    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([role, module])
  @@map("role_permissions")
}
